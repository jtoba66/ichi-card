[Unit]
Description=Ichi Scorecard dashboard static file server
After=network.target

[Service]
Type=simple
User=joseph
WorkingDirectory=/home/joseph/ichi-scorecard
ExecStart=/usr/bin/python3 -m http.server 7890 --directory /home/joseph/ichi-scorecard/dashboard
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
